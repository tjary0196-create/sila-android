rules_version = '2';

// =====================================================================
// Sila — Firestore Security Rules
//
// Design principles enforced here:
//  1. A user can only ever write documents keyed by their own uid.
//  2. "users/{uid}" is PRIVATE — only the owner may read or write it.
//     It is never readable by any other client, closing the privacy
//     leak where any user's full profile (bio/birthdate/country) was
//     reachable simply by knowing their uid.
//  3. "publicProfiles/{uid}" is the ONLY profile surface other users
//     may read, and it is schema-validated on write so private fields
//     can never leak into it by accident.
//  4. "usernames/{key}" is create-once / immutable — nobody can steal
//     or overwrite a claimed username, and the uid stored inside must
//     match the writer's own auth uid.
//  5. "chats/{chatId}" and its "messages" subcollection are only
//     readable/writable by the two participants, messages are
//     immutable once sent (no edit/delete), and senderId is always
//     verified against request.auth.uid — the server no longer trusts
//     a client-supplied senderId.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    // ---------------------------------------------------------------
    // users/{uid} — PRIVATE profile. Owner-only, both read and write.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid;
      allow update: if isOwner(uid)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false; // account deletion should go through a trusted backend, not a direct client delete
    }

    // ---------------------------------------------------------------
    // publicProfiles/{uid} — the ONLY profile surface visible to
    // other users. Readable by any signed-in user; writable only by
    // the owner, and only with an allow-listed set of fields so a
    // client can never smuggle a private field in here.
    // ---------------------------------------------------------------
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid)
                   && request.resource.data.uid == uid
                   && request.resource.data.keys().hasOnly([
                        'uid', 'username', 'displayName', 'photoUrl',
                        'status', 'showLastSeen', 'bio', 'birthDate', 'country'
                      ])
                   && isNonEmptyString(request.resource.data.username)
                   && request.resource.data.displayName is string;
    }

    // ---------------------------------------------------------------
    // usernames/{key} — create-once uniqueness registry. Once
    // claimed, a username can never be reassigned or stolen by a
    // different uid, and it can only ever point at the caller's own
    // uid.
    // ---------------------------------------------------------------
    match /usernames/{key} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && key == key.lower()
                    && key.matches('^[a-z0-9_.]{3,20}$');
      allow update, delete: if false; // immutable once claimed
    }

    // ---------------------------------------------------------------
    // chats/{chatId} — only the two participants may read or write.
    // The participants list itself can never be changed after
    // creation (prevents adding/removing yourself from someone
    // else's conversation).
    // ---------------------------------------------------------------
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastMessage', 'updatedAt']);

      allow delete: if false;

      // -----------------------------------------------------------
      // chats/{chatId}/messages/{messageId} — immutable once sent.
      // senderId must equal the caller's own uid (no impersonation),
      // and only an existing participant of the parent chat may
      // read or create messages here.
      // -----------------------------------------------------------
      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.senderId == request.auth.uid
                      && isNonEmptyString(request.resource.data.text)
                      && request.resource.data.text.size() <= 4000;

        allow update, delete: if false; // messages are immutable — no edit/delete once sent
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
