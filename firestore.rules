rules_version = '2';

// =====================================================================
// Sila — Firestore Security Rules
//
// Design principles enforced here:
//  1. A user can only ever write documents keyed by their own uid.
//  2. "users/{uid}" is PRIVATE — only the owner may read or write it.
//  3. "publicProfiles/{uid}" is the ONLY profile surface other SIGNED-IN
//     users may read, and it is schema-validated on write (an allow-list
//     of fields) so private fields (bio/birthDate/country hidden by the
//     owner's privacy toggles) can never leak into it — whether from the
//     real app or from a modified client calling Firestore directly.
//  4. "usernames/{key}" is create-once / immutable, and the key itself
//     must match the same format the app enforces client-side, so a
//     non-app client can't register something the UI would never allow.
//  5. "chats/{chatId}" and its "messages" subcollection are only
//     readable/writable by the two participants, messages are immutable
//     once sent, senderId is always verified against request.auth.uid,
//     and createdAt must equal the server's own request time (a client
//     can no longer backdate or postdate a message).
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    // ---------------------------------------------------------------
    // users/{uid} — PRIVATE profile. Owner-only, both read and write.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && request.resource.data.uid == resource.data.uid;
      allow delete: if false; // account deletion should go through a trusted backend, not a direct client delete
    }

    // ---------------------------------------------------------------
    // publicProfiles/{uid} — the ONLY profile surface visible to other
    // users. Readable only by SIGNED-IN users (not the public internet);
    // writable only by the owner, and only with an allow-listed set of
    // fields so a client can never smuggle a private field in here —
    // this is what actually enforces the privacy toggles on the server,
    // not just in the app's own UI logic.
    // ---------------------------------------------------------------
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid)
                   && request.resource.data.uid == uid
                   && request.resource.data.keys().hasOnly([
                        'uid', 'username', 'displayName', 'photoUrl',
                        'status', 'showLastSeen', 'bio', 'birthDate', 'country'
                      ])
                   && isNonEmptyString(request.resource.data.username)
                   && request.resource.data.displayName is string;
    }

    // ---------------------------------------------------------------
    // usernames/{key} — create-once uniqueness registry. Format/length
    // enforced here too (not just client-side), so a non-app client
    // can't register something the UI would never have allowed. Once
    // claimed, a username can never be reassigned or stolen.
    // ---------------------------------------------------------------
    match /usernames/{key} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && key == key.lower()
                    && key.matches('^[a-z0-9_.]{3,20}$')
                    && !exists(/databases/$(database)/documents/usernames/$(key));
      allow update, delete: if false; // immutable once claimed
    }

    // ---------------------------------------------------------------
    // chats/{chatId} — only the two participants may read or write.
    // ---------------------------------------------------------------
    match /chats/{chatId} {
      allow create: if isSignedIn()
                    && request.resource.data.participants is list
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      allow read: if isSignedIn()
                  && (resource == null || request.auth.uid in resource.data.participants);

      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);

      allow delete: if false;

      // -----------------------------------------------------------
      // chats/{chatId}/messages/{messageId} — immutable once sent.
      // Message length (4000 chars) matches the client-side check in
      // ChatViewModel.sendMessage / FirestoreChatRepository.sendText —
      // keep these in sync if either one ever changes, otherwise
      // messages that pass client validation will silently fail here.
      // -----------------------------------------------------------
      match /messages/{messageId} {
        allow create: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.senderId == request.auth.uid
                      && isNonEmptyString(request.resource.data.text)
                      && request.resource.data.text.size() <= 4000
                      && request.resource.data.createdAt == request.time;

        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow update, delete: if false; // messages are immutable — no edit/delete once sent
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
